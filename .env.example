# Public client configuration. EXPO_PUBLIC_* values are embedded in the app
# bundle and must never contain API credentials.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Google OAuth Configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# Server-only credentials used by the API routes. Configure real values in
# your deployment secret store; they must not use the EXPO_PUBLIC_ prefix.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional server-side TTS configuration
TTS_PROVIDER=elevenlabs
OPENAI_BASE_URL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
